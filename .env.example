# Address of the deployed SaveFactory contract (required).
# The app refuses to start without it. Arc Testnet, deployed at block 54503427.
NEXT_PUBLIC_FACTORY_ADDRESS=0x0a12aEa5A35d7199F2B7cac3C14A7a9e470F561a

# Explorer transaction URL prefix (optional, default https://testnet.arcscan.app/tx/)
NEXT_PUBLIC_ARC_EXPLORER_TX=https://testnet.arcscan.app/tx/
